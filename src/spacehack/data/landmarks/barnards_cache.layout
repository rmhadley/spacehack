# barnards_cache.layout - the old crew's staging cache (Barnard's Star b delve)
#
# Where the old job staged its runs and, when the Militia buried the
# file, where the crew buried the hardware. A planked strong-cache
# opens off the staging hall; the cell site is authored at its center.
# One leftover Militia watch drone holds the room.
MAP
###############
#####.....#####
#####.o%o.#####
#####.....#####
#######.#######
#.............#
#.o.........o.#
#.............#
#.o.........o.#
#######e#######
ENDMAP

TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: o = CITY_ORNAMENT
TILE: % = QUEST_CACHE
TILE: e = LANDMARK_ENTRANCE

COLOUR: # = (110, 95, 80) / (32, 26, 20)    # shipped planks and steel, decades dark
COLOUR: . = (150, 120, 90) / (45, 36, 26)   # trampled dirt over tarp
COLOUR: o = (146, 138, 84) / (46, 44, 26)   # old Militia crates and racks
COLOUR: e = (215, 170, 110) / (46, 36, 22)  # lit threshold into the cache
