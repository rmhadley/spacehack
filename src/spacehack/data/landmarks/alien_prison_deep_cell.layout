###########XX^XXX^e^XXX^XX########
ENDMAP

TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: X = TORN_DOOR
TILE: ^ = CLAW_SCAR
TILE: e = LANDMARK_ENTRANCE

COLOUR: # = (105, 90, 115) / (22, 25, 38)       # cell wall
COLOUR: . = (190, 200, 215) / (35, 45, 60)       # deep-cell floor
COLOUR: X = (230, 125, 80) / (65, 32, 26)        # torn door metal
COLOUR: ^ = (240, 150, 105) / (55, 35, 42)       # giant claw scars
COLOUR: e = (255, 165, 100) / (72, 36, 24)       # open, torn entrance
