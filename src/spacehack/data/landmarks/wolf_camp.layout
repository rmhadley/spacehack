# wolf_camp.layout - frozen prospectors' bunkhouse (Wolf 359 b delve)
#
# The consortium's advance camp: a cabin of shipped timbers sunk into
# the ice, bunks and crates still stacked. The escrow cache sits at
# its heart, with the leftover security detail standing watch.
MAP
###############
#.............#
#.#..D......#.#
#.#...o.o...#.#
#......%......#
#.#...o.o...#.#
#.#......D..#.#
#.............#
######d########
ENDMAP

TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: o = CITY_ORNAMENT
TILE: d = DUNGEON_DOOR

ENEMY: D = sentry_drone@1.0
TILE: % = QUEST_CACHE

COLOUR: # = (110, 78, 52) / (30, 20, 12)      # shipped timbers
COLOUR: . = (150, 130, 100) / (40, 33, 22)    # packed snow trampled to dirt
COLOUR: o = (235, 190, 110) / (70, 52, 28)    # crates and bunks, lantern-lit
COLOUR: % = (255, 215, 0) / (60, 48, 18)       # escrow cache site
