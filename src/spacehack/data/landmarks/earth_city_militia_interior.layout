# earth_city_militia_interior.layout
# The exit sits directly below the spawn point, so stepping back
# through the door is one move from where you entered.
MAP
##################
#................#
#..bbbb....bbbb..#
#..b..........b..#
#..b....*....b...#
#..bbbb....bbbb..#
#................#
#....*...........#
#........P.......#
#........>.......#
##################
ENDMAP

TILE: # = CITY_BUILDING_WALL
TILE: . = CITY_BUILDING_FLOOR
TILE: b = CITY_BUILDING_WALL
TILE: * = CITY_FOUNTAIN
TILE: > = EXIT
COLOUR: b = (110, 185, 190) / (42, 72, 76)
COLOUR: * = (120, 240, 255) / (36, 96, 110)
