# earth_city_spaceport_interior.layout
# The exit sits directly below the spawn point, so stepping back
# through the door is one move from where you entered.
MAP
##################
#................#
#..S....S....c...#
#................#
#....*.....*.....#
#................#
#..s....h....c...#
#................#
#........P.......#
#........>.......#
##################
ENDMAP

TILE: # = CITY_BUILDING_WALL
TILE: . = INTERIOR
TILE: s = CITY_ORNAMENT
TILE: h = CITY_FOUNTAIN
TILE: c = CITY_BRIDGE
TILE: * = CITY_ORNAMENT
TILE: > = EXIT
TILE: S = SHOWROOM_BERTH
COLOUR: s = (120, 220, 255) / (42, 72, 92)
COLOUR: h = (255, 190, 90) / (88, 64, 34)
COLOUR: c = (180, 220, 235) / (55, 72, 88)
