# Tile mappings — glyph -> world.Tile constant name
# Entity markers (P, C, E, r, R, S) are handled by the parser;
# only map tiles need TILE directives.
TILE: + = DUNGEON_WALL
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: C = DOOR_CONSOLE
TILE: = = UNDULATING_DOOR_A
TILE: ~ = UNDULATING_DOOR_B

# Optional color overrides.  Omit a generic dungeon tile here to
# inherit the destination cave's themed tile when this landmark is stamped.
# COLOUR changes only the foreground color; the destination theme supplies
# the generic tile's glyph, background, and collision behavior.
COLOUR: + = (120, 130, 150)     # alien wall
COLOUR: . = (200, 200, 210)     # alien floor
COLOUR: = = (46, 219, 211)      # alien door a
COLOUR: ~ = (46, 99, 219)       # alien door b
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: C = (255, 200, 80)      # door console — warm gold
