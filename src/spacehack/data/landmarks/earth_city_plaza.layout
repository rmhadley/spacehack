# earth_city_plaza.layout - Earth central plaza
# A paved square with a jewel fountain; every cell is a walkable
# plaza tile or the decorative fountain itself. Kept rectangular so
# no void padding leaks into the city map.
MAP
...............
......*o*......
.....*****.....
...***www***...
...**wwwww**...
...**wwwww**...
...***www***...
......*o*......
...............
ENDMAP

TILE: . = CITY_PLAZA
TILE: * = CITY_FOUNTAIN
TILE: o = CITY_ORNAMENT
TILE: w = CITY_WATER
COLOUR: . = (235, 235, 220) / (120, 132, 120)
COLOUR: * = (120, 235, 255) / (36, 104, 122)
COLOUR: o = (255, 220, 90) / (92, 70, 30)
COLOUR: w = (80, 190, 235) / (22, 82, 110)
