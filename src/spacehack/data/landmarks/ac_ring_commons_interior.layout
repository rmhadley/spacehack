# ac_ring_commons_interior.layout
# Crew commons bar: a counter ring (the barkeep seats behind it,
# nearest clear cell to the room's center) with drinks tables for
# the off-watch crews. The exit sits directly below the spawn point.
MAP
#################
#...............#
#..bbbbbbbb.....#
#..b......b..t..#
#..b..t...b.....#
#..b..t...b..t..#
#..b......b.....#
#..bbbbbbbb.....#
#.......P.......#
########>########
ENDMAP

TILE: # = CITY_BUILDING_WALL
TILE: . = CITY_BUILDING_FLOOR
TILE: b = BAR_BODY
TILE: t = TABLE
TILE: g = DRINK
TILE: > = EXIT
COLOUR: b = (180, 130, 80) / (90, 62, 38)
COLOUR: t = (255, 200, 80) / (110, 82, 46)
COLOUR: g = (255, 90, 60) / (110, 82, 46)
