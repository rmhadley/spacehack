# mercury_commons.layout - Mercury station commons plaza
# A small paved gathering square with a coolant fountain at its
# center. Every cell is walkable plaza or the fountain itself.
# Kept rectangular so no void padding leaks into the deck map.
MAP
...........
....*o*....
...*****...
...**w**...
...*****...
....*o*....
...........
ENDMAP

TILE: . = CITY_PLAZA
TILE: * = CITY_FOUNTAIN
TILE: o = CITY_ORNAMENT
TILE: w = CITY_WATER
COLOUR: . = (226, 214, 196) / (110, 96, 78)
COLOUR: * = (150, 235, 255) / (36, 104, 122)
COLOUR: o = (255, 200, 90) / (92, 70, 30)
COLOUR: w = (80, 190, 235) / (22, 82, 110)
