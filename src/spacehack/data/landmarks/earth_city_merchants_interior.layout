# earth_city_merchants_interior.layout
# The exit sits directly below the spawn point, so stepping back
# through the door is one move from where you entered.
MAP
##################
#................#
#..tttt....tttt..#
#..t..........t..#
#..t....*....t...#
#..tttt....tttt..#
#................#
#....*...........#
#........P.......#
#........>.......#
##################
ENDMAP

TILE: # = CITY_BUILDING_WALL
TILE: . = CITY_BUILDING_FLOOR
TILE: t = TABLE
TILE: * = CITY_ORNAMENT
TILE: > = EXIT
COLOUR: t = (185, 220, 150) / (72, 92, 58)
COLOUR: * = (255, 230, 100) / (92, 78, 34)
