# Tile mappings — glyph -> world.Tile constant name
# (label letters are not included — see header note)

TILE: * = NEON
TILE: + = DOOR
TILE: , = GRASS_ACCENT
TILE: - = ROAD_EW
TILE: . = ROAD_SURFACE
TILE: : = ROAD_NS
TILE: A = LANDING_PAD
TILE: B = SIDEWALK
TILE: C = PLAZA
TILE: · = INTERIOR
TILE: ≈ = TABLE
TILE: ─ = WALL_H
TILE: │ = WALL_V
TILE: ┌ = WALL_TL
TILE: ┐ = WALL_TR
TILE: └ = WALL_BL
TILE: ┘ = WALL_BR
TILE: █ = GRASS
TILE: ░ = BAR_COUNTER
TILE: ▒ = BAR_BODY
TILE: ▓ = WALL
TILE: ♣ = TREE
TILE: ♥ = DRINK
TILE: ♦ = DECOR

# Collision notes (different Tile objects share same .char):
  COLLISION: '▓' -> glyph 'A' (LANDING_PAD) = renders as '▓'
  COLLISION: '▒' -> glyph 'B' (SIDEWALK) = renders as '▒'
  COLLISION: '░' -> glyph 'C' (PLAZA) = renders as '░'
