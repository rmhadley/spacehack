# Tile mappings
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: a = AIRLOCK
TILE: b = BREACH
TILE: > = EXIT

# Crew — role tokens (doc 48 SETTLED 28): the boarding hull's faction
# resolves line/heavy/marksman/security_drone/stowaway at load. 16
# stamps, 7 profiles; the cockpit honor guard is the guaranteed
# anchor, everything else rolls per visit. g is the single-slot heavy
# (two stamps, one squad each): the warlord's brutes, the militia
# patrol's marines.
ENEMY: S = line@1.0#2-3
ENEMY: R = marksman@0.5#2-3
ENEMY: r = line@0.45#1-2
ENEMY: f = marksman@0.4#2-4
ENEMY: g = heavy@0.35#1-1
ENEMY: m = stowaway@0.15#2-4
ENEMY: q = security_drone@0.25#1-2

# Loot mappings — warlord stores and munitions
LOOT: 1 = cargo_bay
LOOT: 2 = personal_storage
LOOT: 3 = engine_room
LOOT: 4 = mess_hall

# Color overrides — tiles only; crew identity renders from the
# resolved spec's family color (doc 48 SETTLED 38)
COLOUR: # = (120, 130, 150)
COLOUR: . = (200, 200, 210)
COLOUR: d = (100, 220, 255)
COLOUR: a = (100, 200, 255)
COLOUR: b = (255, 120, 50)
COLOUR: C = (255, 200, 80)
COLOUR: > = (100, 255, 120)
