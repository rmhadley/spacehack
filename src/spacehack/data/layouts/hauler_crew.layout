# Tile mappings
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: a = AIRLOCK
TILE: b = BREACH
TILE: > = EXIT

# Crew — role tokens (doc 48 SETTLED 28): merchant hulls crew honest
# light Merchants (SETTLED 5/7/38); defense is droids — h is the
# single-slot assault-drone anchor, q the security-drone dial (the
# boarded spec's wealth multiplier scales it at load). 22 stamps, 10
# profiles; the cockpit guard is the guaranteed anchor.
ENEMY: n = line@1.0#2-3
ENEMY: u = line@0.5#1-2
ENEMY: f = line@0.45#1-2
ENEMY: k = line@0.45#1-2
ENEMY: g = line@0.4#1-2
ENEMY: j = line@0.3#1-1
ENEMY: h = heavy@0.35#1-1
ENEMY: m = stowaway@0.15#2-4
ENEMY: o = stowaway@0.2#1-2
ENEMY: q = security_drone@0.7#1-2

# Loot mappings — cargo-focused
LOOT: 1 = cargo_bay
LOOT: 2 = personal_storage
LOOT: 3 = engine_room
LOOT: 4 = mess_hall

# Color overrides — tiles only; crew identity renders from the
# resolved spec's family color (doc 48 SETTLED 38)
COLOUR: # = (120, 130, 150)
COLOUR: . = (200, 200, 210)
COLOUR: d = (100, 220, 255)
COLOUR: a = (100, 200, 255)
COLOUR: b = (255, 120, 50)
COLOUR: C = (255, 200, 80)
COLOUR: > = (100, 255, 120)
