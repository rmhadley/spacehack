# scout_a.layout — Standard Scout Interior
# Hull shape traces a spaceship silhouette.
#   Far right:           Cockpit with ship console (C)
#   Far left:            Engine exhaust and two engine rooms (E)
#   Far left middle:     Airlock (a)
#   Long center:         Cargo hold
#   Top middle:          Barracks
#   Bottom middle:       Mess hall
#   Top/bottom right:    Storage (before cockpit)
#   Bottom protrusion:   Breach entry (b) — spawn at P, enter through b
#                        Exit back through b (same way you came in)

MAP
           ##############
           #............#
           #............###########################
           #............#..........#...#..........#
    ########............#..........d...d..........#
    #......#............#..........#...#..........#
    #......d............#..........#...#..........#################
#####......#............#..........d...d..........#...............#
####E......#............#..........#...#..........#...............#
############............#############d####################d##############
   #.......#............#.........................................#.....#
   a.......a............d.........................................d....C#
   #.......#............#.........................................#.....#
############............#############d####################d##############
####E......#............#.........................#...............#
#####......#............#.........................#...............#
    #......d............#.........................#################
    #......#............#.........................#
    ########............#.........................#
           #............#.........................#
           #............###########################
           #............#
           #####b########
               #P#
               ###
ENDMAP

# Tile mappings
TILE: # = wall
TILE: . = floor
TILE: a = airlock
TILE: b = breach
TILE: d = door
TILE: P = player_spawn
TILE: C = cockpit
TILE: E = engine

# Color overrides — each tile type gets a distinct color
COLOUR: # = (120, 130, 150)     # hull/bulkhead — steel grey
COLOUR: . = (200, 200, 210)     # floor — pale metal decking
COLOUR: a = (100, 200, 255)     # airlock — cool blue
COLOUR: b = (255, 120, 50)      # breach — hot orange (cut edge)
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: C = (255, 200, 80)      # cockpit computer — warm gold
COLOUR: E = (180, 200, 220)     # engine — muted blue-white
