# scout_a.layout — Standard Scout Interior
# Hull shape traces a spaceship silhouette.
#   Far right:           Cockpit with ship console (C)
#   Far left:            Engine exhaust and two engine rooms (E)
#   Far left middle:     Airlock (a)
#   Long center:         Cargo hold
#   Top middle:          Barracks
#   Bottom middle:       Mess hall
#   Top/bottom right:    Storage (before cockpit)
#   Bottom protrusion:   Breach entry (b) — spawn at P, enter through b
#                        Exit back through b (same way you came in)

MAP
           ##############
           #............#
           #............###########################
           #............#.....#....#...#....#.....#
    ########............#.....d....d...d....d.....#
    #......#............############...############
    #.....1d............#.....#....#...#....#.....#################
{###}......#............#.....d....d...d....d.....#...............#
{##}E...r..#............#.....#....#...#....#.....#.......3.......#
{##}########............#############d####################d##############
   #.......#............#.........................................#.....#
   a.......a............d.........................................d....C#
   #.......#............#.........................................#.....#
{##}########............#############d####################d##############
{##}E......#............#....R.......2............#.......3.......#
{###}......#............#.........................#...............#
    #.....1d............#.........................#################
    #......#............#.........................#
    ########............#.........................#
           #............#.........................#
           #............###########################
           #....4S......#
           #####b########
               #P#
               #>#
               ###
ENDMAP

# Tile mappings — glyph -> world.Tile constant name
# Entity markers (P, C, E, r, R, S) are handled by the parser;
# only map tiles need TILE directives.
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: a = AIRLOCK
TILE: b = BREACH
TILE: > = EXIT
TILE: { = HULL_WALL
TILE: } = HULL_WALL
TILE: % = DEBRIS

# Enemy spawn markers class@chance#min_num-max_num
ENEMY: r = pirate_raider@1.0
ENEMY: R = pirate_rifleman@1.0#2-4
ENEMY: S = pirate_raider@1.0#3-3

# Loot mappings
LOOT: 1 = engine_room
LOOT: 2 = mess_hall
LOOT: 3 = personal_storage
LOOT: 4 = cargo_bay

# Color overrides — each tile type gets a distinct color
COLOUR: # = (120, 130, 150)     # hull/bulkhead — steel grey
COLOUR: { = (120, 130, 150)     # hull bracket — cool steel blue, slightly brighter than #
COLOUR: } = (120, 130, 150)     # hull bracket -- cool steel blue, slightly brighter than #
COLOUR: . = (200, 200, 210)     # floor — pale metal decking
COLOUR: a = (100, 200, 255)     # airlock — cool blue
COLOUR: b = (255, 120, 50)      # breach — hot orange (cut edge)
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: C = (255, 200, 80)      # cockpit computer — warm gold
COLOUR: E = (180, 200, 220)     # engine — muted blue-white
COLOUR: > = (100, 255, 120)     # exit — bright green arrow
COLOUR: r = (220, 120, 80)      # pirate raider — rust-orange
COLOUR: R = (200, 80, 80)       # pirate rifleman — faded red
