# Tile mappings
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: a = AIRLOCK
TILE: b = BREACH
TILE: > = EXIT



# Color overrides
COLOUR: # = (120, 130, 150)
COLOUR: b = (200, 120, 90)

# Crew — varied spawns: scout-scale (9 stamps, 6 profiles). The bridge
# watch is the guaranteed anchor; everything else rolls per visit.
ENEMY: S = pirate_raider@1.0#1-2
ENEMY: R = pirate_rifleman@0.5#1-2
ENEMY: r = pirate_raider@0.35#1-1
ENEMY: g = pirate_raider@0.4#1-1
ENEMY: m = hull_parasite@0.15#1-3
ENEMY: q = sentry_drone@0.25#1-1

# Loot mappings — scout stores
LOOT: 1 = cargo_bay
LOOT: 2 = personal_storage
LOOT: 3 = engine_room
LOOT: 4 = mess_hall

