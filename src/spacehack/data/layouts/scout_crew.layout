# Tile mappings
TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: a = AIRLOCK
TILE: b = BREACH
TILE: > = EXIT



# Color overrides
COLOUR: # = (120, 130, 150)
COLOUR: b = (200, 120, 90)

# Crew — role tokens (doc 48 SETTLED 28): the boarding hull's faction
# resolves line/heavy/marksman/security_drone/stowaway at load. Scout
# scale (9 stamps, 6 profiles): the bridge watch is the guaranteed
# anchor; everything else rolls per visit. No heavy — a small boat
# carries no brute.
ENEMY: S = line@1.0#1-2
ENEMY: R = marksman@0.5#1-2
ENEMY: r = line@0.35#1-1
ENEMY: g = line@0.4#1-1
ENEMY: m = stowaway@0.15#1-3
ENEMY: q = security_drone@0.25#1-1

# Loot mappings — scout stores
LOOT: 1 = cargo_bay
LOOT: 2 = personal_storage
LOOT: 3 = engine_room
LOOT: 4 = mess_hall

# Color overrides — tiles only; crew identity renders from the
# resolved spec's family color (doc 48 SETTLED 38)
COLOUR: # = (120, 130, 150)
COLOUR: . = (200, 200, 210)
COLOUR: d = (100, 220, 255)
COLOUR: a = (100, 200, 255)
COLOUR: b = (255, 120, 50)
COLOUR: C = (255, 200, 80)
COLOUR: > = (100, 255, 120)
