# scout_b.layout — Fortified Scout
# Same hull, fortified interior. The crew reinforced bulkheads
# and created defensible chokepoints. More enemies, tighter
# corridors, fewer open spaces. The barracks and cargo hold
# are subdivided into smaller compartments.
#
#   Far right:           Cockpit with ship console (C)
#   Far left:            Engine rooms (E) — 2 enemies
#   Center:              Fortified cargo hold with barricades
#   Top:                 Crew barracks (small rooms)
#   Bottom:              Mess hall with barricaded positions
#   Bottom protrusion:   Breach entry (b) — spawn at P, exit same way

MAP
           ##############
           #..#...#...#..#
           #..#...#...##########################
           #..#...#...#....#..#....#..d........#
    ########..#...#...#....#..#....d...#.......#
    #..#...#..#...#...#....#..#....#..#.......#
    #..#.d.#..#...#...#....#..#....#..#.......##############
#####..#...#..#...d...#....d..d....d..#..E..............#
####..#...#..#...#...#....#..#....#..#.........#......#
###d####.###d####...###d######.###d#####.###d####.###d######
   #..#d..#..#........#.................#..#.....#....#
   a..#d..#..a........d.................d..#.....C....#
   #..#d..#..#........#.................#..#.....#....#
###d####.###d####...###d######.###d#####.###d####.###d######
####..#...#..#...#...#....#..#....#..#.........#......#
#####..#...#..#...d...#....d..d....d..#..E..............#
    #..#.d.#..#...#...#....#..#....#..#.......##############
    #..#...#..#...#...#....#..#....#..#.......#
    ########..#...#...#....#..#....#..#.......#
           #..#...#...#....#..#....#..#.......#
           #..#...#...##########################
           #..#...#..#
           #####b######
               #P#
               ###
ENDMAP

# Tile mappings
TILE: # = wall
TILE: . = floor
TILE: a = airlock
TILE: b = breach
TILE: d = door
TILE: P = player_spawn
TILE: C = cockpit
TILE: E = engine

# Color overrides
COLOUR: # = (120, 130, 150)     # hull/bulkhead — steel grey
COLOUR: . = (200, 200, 210)     # floor — pale metal decking
COLOUR: a = (100, 200, 255)     # airlock — cool blue
COLOUR: b = (255, 120, 50)      # breach — hot orange (cut edge)
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: C = (255, 200, 80)      # cockpit computer — warm gold
COLOUR: E = (180, 200, 220)     # engine — muted blue-white
