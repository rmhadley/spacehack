# station_research.layout — Abandoned Research Station
# A small surface outpost on a frontier planet. Compact layout
# with research lab, crew quarters, storage, and engine room.
#
# Entry: P (player spawn) in the airlock area
# Exit: > back to the landing site
# Layout designed for 40x30 so it fits on one screen centered

MAP
     #################################
     #..............#................#
     #......3.......#......2.........#
     #..............d................#
     ####d###########......###########
     #...............#......#........#
     #...............#......#........#
     #...1...........#......#...4....#
     #...............a......#........#
     #...............#......##########
     ########d#########...............#
     #..............#.................#
     #..............#......E..........#
     #..............#.....E...........#
     #..............d..........C......#
     #..............#.................#
     ########d#########...............#
            #.......a.................#
            #.......a.........>.......#
            #.......a.........P.......#
            ###########################
ENDMAP

# Tile mappings
TILE: # = wall
TILE: . = floor
TILE: d = door
TILE: a = airlock
TILE: > = exit
TILE: P = player_spawn
TILE: C = cockpit
TILE: E = engine

# Enemy markers — station security drones
ENEMY: R = pirate_rifleman@0.5

# Loot mappings
LOOT: 1 = personal_storage
LOOT: 2 = mess_hall
LOOT: 3 = engine_room
LOOT: 4 = cargo_bay

# Color overrides
COLOUR: # = (120, 130, 150)     # bulkhead — steel grey
COLOUR: . = (200, 200, 210)     # floor — pale metal
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: a = (140, 200, 240)     # airlock — lighter cyan
COLOUR: > = (100, 255, 120)     # exit — bright green
COLOUR: C = (255, 200, 80)      # comms console — warm gold
COLOUR: E = (180, 200, 220)     # engine — muted blue-white
COLOUR: R = (200, 80, 80)       # rifleman — faded red
