# scout_c.layout — Stripped Scout
# Same hull, gutted interior. Salvage operations were underway —
# bulkheads were torn out, cargo is scattered everywhere, and
# some sections have collapsed into debris fields (%). The
# ship is one big open space with a few remaining walls.
#
#   Far right:           Cockpit with ship console (C)
#   Far left:            Engine rooms (E) — damaged, 1 enemy
#   Center:              Open cargo bay — loot scattered
#   Top/bottom:          Collapsed barracks/mess — debris
#   Bottom protrusion:   Breach entry (b) — spawn at P, exit same way

MAP
           ##############
           #...%..%%.....#
           #...%..%%....##########################
           #....%%..............#................#
    ########....%%..............d................#
    #...........%%..............#................#
    #...........%%..............#................###############
#####..........%%.....E........#.............................#
####...........%%..............#.............................#
##########.............############.####################.########
   #.......%........%..#.........................................#.....#
   a.......a...........d..............%......%.................d....C#
   #.......%........%..#.........................................#.....#
##########.............############.####################.########
####...........%%..............#.............................#
#####..........%%..............#.............................#
    #...........%%..............#................###############
    #...........%%..............#................#
    ########....%%..............#................#
           #....%%..............#................#
           #...%..%%....##########################
           #...%..%%..#
           #####b######
               #P#
               ###
ENDMAP

# Tile mappings
TILE: # = wall
TILE: . = floor
TILE: a = airlock
TILE: b = breach
TILE: d = door
TILE: % = debris
TILE: P = player_spawn
TILE: C = cockpit
TILE: E = engine

# Color overrides
COLOUR: # = (120, 130, 150)     # hull/bulkhead — steel grey
COLOUR: . = (200, 200, 210)     # floor — pale metal decking
COLOUR: a = (100, 200, 255)     # airlock — cool blue
COLOUR: b = (255, 120, 50)      # breach — hot orange (cut edge)
COLOUR: d = (100, 220, 255)     # door — cyan glow
COLOUR: % = (140, 130, 100)     # debris — dusty brown
COLOUR: C = (255, 200, 80)      # cockpit computer — warm gold
COLOUR: E = (180, 200, 220)     # engine — muted blue-white
