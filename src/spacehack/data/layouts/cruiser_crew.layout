# cruiser_crew.layout — Pirate Raider crew deck (live-ship capture, doc 40 6a)
# Mid-size hull: cockpit forward, crew quarters port, hold starboard,
# engine room aft. A raider carries a real crew — clear it to reach
# the cockpit console.

MAP
      ################################
      #......#..........#............#
      #..1...d..........d......2.....#
      #......#....r.....#............#
      ###d#####################d#######
      #..........#......#............#
      #..........d......d......%.....#
      #....r.....#......#.....C......#
      ############......#####d#########
      #..........#......#............#
      #...R......d......d......3.....#
      #..........#......#............#
      #####d########d#########d########
      #..............................#
      #..............................#
      ###############d#################
                    #.b.#
                    #...#
                    #.P.#
                    #.>.#
                    #####
ENDMAP

TILE: # = DUNGEON_WALL
TILE: . = DUNGEON_FLOOR
TILE: d = DUNGEON_DOOR
TILE: b = BREACH
TILE: > = EXIT
TILE: % = DEBRIS

# A raider's crew: a gunner pair forward, the bosun midships
ENEMY: r = pirate_raider@1.0#1-2
ENEMY: R = pirate_rifleman@1.0#1-3

LOOT: 1 = engine_room
LOOT: 2 = mess_hall
LOOT: 3 = personal_storage

COLOUR: # = (120, 130, 150)
COLOUR: % = (150, 130, 100)
